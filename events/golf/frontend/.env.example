# Set after deploying the GolfBackend CDK stack.
# The value is the CfnOutput 'SubmitApiUrl' (Lambda Function URL, trailing slash included).
# Example: https://abcdefghij.lambda-url.us-east-2.on.aws/
VITE_GOLF_SUBMIT_API_URL=

# Only needed for local dev. In production CloudFront serves the read API same-origin at /api/*,
# so application code always fetches '/api/...' and needs no base URL. The dev server proxies that
# same prefix here instead (see vite.config.js).
# The value is the CfnOutput 'GolfReadApiUrl' (Lambda Function URL, trailing slash included).
# See events/golf/backend/README.md for the routes.
VITE_GOLF_READ_API_URL=
